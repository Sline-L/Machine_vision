# EdgeMedic Agent env — copy to edgemedic-agent.env on the target host.
# Default is observe_only. execute_replay only against isolated Replay Control.

EDGEMEDIC_CONTROL_URL=http://127.0.0.1:8788
EDGEMEDIC_LLM_URL=http://127.0.0.1:8080
EDGEMEDIC_EXECUTION_MODE=observe_only
EDGEMEDIC_STATUS_HOST=127.0.0.1
EDGEMEDIC_STATUS_PORT=8790
EDGEMEDIC_PIDFILE=/tmp/edgemedic-agent.pid

# Optional: start monitoring on boot (still does NOT arm recovery).
# Pass --auto-monitor via a drop-in or wrapper if needed.
