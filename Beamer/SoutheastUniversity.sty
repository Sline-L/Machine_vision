\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{SoutheastUniversity}[2026/09/28 Southeast University Beamer theme]

\mode<presentation>

\RequirePackage{graphicx}
\RequirePackage{xcolor}

% Colors sampled from pic/原配色.svg.
\definecolor{seugreen}{HTML}{3D6016}
\definecolor{seugreendark}{HTML}{29450F}
\definecolor{seugreenlight}{HTML}{E8EFE0}
\definecolor{seuyellow}{HTML}{FFCC00}
\definecolor{seuyellowlight}{HTML}{FFF3B5}
\definecolor{seugold}{HTML}{E6B800}
\definecolor{seuink}{HTML}{20251B}
\definecolor{seugray}{HTML}{66705D}
\definecolor{seubackground}{HTML}{FAFBF7}

\useoutertheme[subsection=false]{smoothbars}
\useinnertheme{circles}

\setbeamercolor{normal text}{fg=seuink,bg=seubackground}
\setbeamercolor{structure}{fg=seugreen}
\setbeamercolor{alerted text}{fg=seugreendark}

\setbeamercolor{palette primary}{fg=white,bg=seugreen}
\setbeamercolor{palette secondary}{fg=white,bg=seugreendark}
\setbeamercolor{palette tertiary}{fg=seugreendark,bg=seuyellow}
\setbeamercolor{palette quaternary}{fg=white,bg=seugreendark}

\setbeamercolor{title}{fg=white,bg=seugreen}
\setbeamercolor{subtitle}{fg=seuyellow}
\setbeamercolor{author}{fg=seugreendark}
\setbeamercolor{institute}{fg=seugray}
\setbeamercolor{date}{fg=seugray}
\setbeamercolor{frametitle}{fg=white,bg=seugreen}
\setbeamercolor{framesubtitle}{fg=seuyellow}

\setbeamercolor{block title}{fg=white,bg=seugreen}
\setbeamercolor{block body}{fg=seuink,bg=seugreenlight}
\setbeamercolor{block title example}{fg=seugreendark,bg=seuyellow}
\setbeamercolor{block body example}{fg=seuink,bg=seuyellowlight}
\setbeamercolor{block title alerted}{fg=seugreendark,bg=seuyellow}
\setbeamercolor{block body alerted}{fg=seuink,bg=seuyellowlight}

\setbeamercolor{item projected}{fg=white,bg=seugreen}
\setbeamercolor{subitem projected}{fg=seugreendark,bg=seuyellow}
\setbeamercolor{section in toc}{fg=seugreen}
\setbeamercolor{subsection in toc}{fg=seugray}
\setbeamercolor{section in toc shaded}{fg=seugray!55}
\setbeamercolor{subsection in toc shaded}{fg=seugray!45}
\setbeamercolor{minor navigation}{fg=white,bg=seugreen}
\setbeamercolor{minor navigation active}{fg=seuyellow,bg=seugreendark}

\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,series=\mdseries}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{minor navigation}{size=\scriptsize}
\setbeamerfont{minor navigation active}{size=\scriptsize,series=\bfseries}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{itemize item}{\color{seugreen}\small$\bullet$}
\setbeamertemplate{itemize subitem}{\color{seugold}\scriptsize$\blacktriangleright$}

\makeatletter
\newif\ifgearpro@shownav
\gearpro@shownavfalse
\newcommand{\gearpro@majorlabel}{阶段汇报}
\newcommand{\gearpro@navcount}{0}
\newcommand{\gearpro@active}{0}
\newcommand{\gearpro@navone}{}
\newcommand{\gearpro@navtwo}{}
\newcommand{\gearpro@navthree}{}
\newcommand{\gearpro@navfour}{}
\newcommand{\gearpro@navfive}{}

\newcommand{\GearProSetMajor}[1]{\renewcommand{\gearpro@majorlabel}{#1}}
\newcommand{\GearProHideMinorNav}{\gearpro@shownavfalse}
\newcommand{\GearProSetMinorNavFive}[6]{%
  \renewcommand{\gearpro@navcount}{5}%
  \renewcommand{\gearpro@navone}{#1}%
  \renewcommand{\gearpro@navtwo}{#2}%
  \renewcommand{\gearpro@navthree}{#3}%
  \renewcommand{\gearpro@navfour}{#4}%
  \renewcommand{\gearpro@navfive}{#5}%
  \renewcommand{\gearpro@active}{#6}%
  \gearpro@shownavtrue
}
\newcommand{\GearProSetMinorNavThree}[4]{%
  \renewcommand{\gearpro@navcount}{3}%
  \renewcommand{\gearpro@navone}{#1}%
  \renewcommand{\gearpro@navtwo}{#2}%
  \renewcommand{\gearpro@navthree}{#3}%
  \renewcommand{\gearpro@active}{#4}%
  \gearpro@shownavtrue
}

\newcommand{\gearpro@navitem}[3]{%
  \ifnum\gearpro@active=#1\relax
    \begin{beamercolorbox}[wd=#2,ht=2.45ex,dp=.9ex,center]{minor navigation active}%
      \usebeamerfont{minor navigation active}\strut #3%
    \end{beamercolorbox}%
  \else
    \begin{beamercolorbox}[wd=#2,ht=2.45ex,dp=.9ex,center]{minor navigation}%
      \usebeamerfont{minor navigation}\strut #3%
    \end{beamercolorbox}%
  \fi
}

\setbeamertemplate{headline}{%
  \ifgearpro@shownav
    \leavevmode%
    \ifnum\gearpro@navcount=5\relax
      \hbox{%
        \gearpro@navitem{1}{.2\paperwidth}{\gearpro@navone}%
        \gearpro@navitem{2}{.2\paperwidth}{\gearpro@navtwo}%
        \gearpro@navitem{3}{.2\paperwidth}{\gearpro@navthree}%
        \gearpro@navitem{4}{.2\paperwidth}{\gearpro@navfour}%
        \gearpro@navitem{5}{.2\paperwidth}{\gearpro@navfive}%
      }%
    \else
      \hbox{%
        \gearpro@navitem{1}{.333333\paperwidth}{\gearpro@navone}%
        \gearpro@navitem{2}{.333333\paperwidth}{\gearpro@navtwo}%
        \gearpro@navitem{3}{.333334\paperwidth}{\gearpro@navthree}%
      }%
    \fi
  \fi
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.15ex,dp=1.15ex,leftskip=.55cm,rightskip=.55cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else%
      \hspace{.65em}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
    \fi%
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode%
  \begin{beamercolorbox}[wd=\paperwidth]{palette primary}%
    \vbox to 3.65ex{%
      \vfil
      \hbox to \paperwidth{%
        \hskip.45cm\usebeamerfont{footline}\gearpro@majorlabel%
        \hfill%
        \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber\hskip.45cm%
      }%
      \vfil
    }%
  \end{beamercolorbox}%
}

\setbeamertemplate{title page}{%
  \vbox{}
  \vfill
  \begin{centering}
    \inserttitlegraphic\par
    \vskip1.0em
    \begin{beamercolorbox}[sep=1.0em,center]{title}
      \usebeamerfont{title}\inserttitle\par
      \ifx\insertsubtitle\@empty\else
        \vskip.55em
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
      \fi
    \end{beamercolorbox}
    \vskip1.0em
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
    \vskip.25em
    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
    \vskip.25em
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
  \end{centering}
  \vfill
}
\makeatother

\setbeamertemplate{section page}{%
  \begin{centering}
    \vfill
    \includegraphics[width=.13\paperwidth]{pic/Southeast_University_Logo.pdf}\par
    \vskip1em
    \begin{beamercolorbox}[sep=1em,center]{title}
      \usebeamerfont{title}\insertsectionhead
    \end{beamercolorbox}
    \vfill
  \end{centering}
}

\mode<all>
